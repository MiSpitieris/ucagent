figure.figsize: 6.4, 4.0
figure.dpi: 120
savefig.dpi: 200
savefig.bbox: tight
font.size: 10
axes.titlesize: 11
axes.labelsize: 10
axes.grid: True
grid.alpha: 0.3
grid.linestyle: --
axes.spines.top: False
axes.spines.right: False
legend.frameon: False
legend.fontsize: 8.5
lines.linewidth: 1.6
lines.markersize: 5
axes.prop_cycle: cycler('color', ['4C72B0', 'DD8452', '55A868', 'C44E52', '8172B3', '937860', 'DA8BC3', '8C8C8C'])
